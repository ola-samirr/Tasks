<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Employee Management</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; padding: 0; background: #f7f7f7; }
    header { background: #2c3e50; color: #fff; padding: 1em; text-align: center; }
    main { max-width: 800px; margin: 2em auto; background: #fff; padding: 2em; border-radius: 8px; }
    table { width: 100%; border-collapse: collapse; margin-top: 1em; }
    th, td { padding: 0.75em; border-bottom: 1px solid #ccc; text-align: left; }
    .btn { padding: 0.5em 1em; border: none; border-radius: 4px; cursor: pointer; margin-right: 0.5em; text-decoration: none; }
    .btn-primary { background: #3498db; color: white; }
    .btn-warning { background: #3acb74; color: black; }
    .btn-danger { background: #b81f0e; color: white; }
    .form-group { margin-bottom: 1em; }
    label { display: block; margin-bottom: 0.5em; }
    input, select { width: 100%; padding: 0.5em; border: 1px solid #ccc; border-radius: 4px; }
  </style>
</head>
